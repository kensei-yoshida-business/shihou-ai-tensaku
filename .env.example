# ---- データベース ----
# アプリ用。本番はプーリング接続（Neon の -pooler ホスト、Supabase の 6543 ポート等）の URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shihou
# マイグレーション用。プーリングを通さない直接接続の URL（ローカルでは DATABASE_URL と同じでよい）
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shihou

# ---- 認証（Auth.js v5） ----
AUTH_SECRET=                         # npx auth secret で生成
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Claude ----
ANTHROPIC_API_KEY=
GRADING_MODEL=claude-opus-5-5        # 原価優先なら claude-sonnet-5-5
EXPLANATION_MODEL=claude-opus-5-5    # 短答解説の一括生成に使うモデル

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TICKET_1=price_...      # 添削チケット1通 800円（一回払い）
STRIPE_PRICE_TICKET_5=price_...      # 5通パック（一回払い）
STRIPE_PRICE_SUB_STANDARD=price_...  # 月額スタンダード（継続）
STRIPE_PRICE_SUB_UNLIMITED=price_... # 月額無制限（継続）
